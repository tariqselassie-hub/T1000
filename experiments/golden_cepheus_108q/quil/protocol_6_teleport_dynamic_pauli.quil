# ==============================================================================
# RIGETTI CEPHEUS-1-108Q GOLDEN BENCHMARK
# Protocol 6: Dynamic Hardware Pauli Frame Feedback (Quil 2.0 Active Branching)
#
# Target Plaquette: P24 (Row 2, Col 2) Centered at 4-Die Intersection:
#   Chiplet 0 (TL) | Chiplet 1 (TR)
#   ---------------+---------------
#   Chiplet 4 (BL) | Chiplet 5 (BR)
#
# Qubit Mapping:
#   Q_TL = 26 (Target 1)
#   Q_TR = 27 (Mediator 1)
#   Q_BL = 38 (Mediator 2)
#   Q_BR = 39 (Target 2)
#
# Real-Time Mid-Circuit Feedback:
#   Demonstrates Rigetti QCS low-latency classical feedback.
#   Directly executes: JUMP-UNLESS @NO_Z s2[0] -> Z 26 -> LABEL @NO_Z
#   Restores 100% of the Bell |Phi+> subspace dynamically on-chip!
# ==============================================================================

DECLARE ro BIT[2]
DECLARE s2 BIT[1]
DECLARE s3 BIT[1]

RESET 26
RESET 27
RESET 38
RESET 39

# ------------------------------------------------------------------------------
# 1. Mediator Preparation & 4-Edge Plaquette Entanglement
# ------------------------------------------------------------------------------
H 27
CNOT 27 26
CNOT 27 39
CNOT 26 38
CNOT 39 38
H 27

# ------------------------------------------------------------------------------
# 2. Mid-Circuit Syndrome Readout
# ------------------------------------------------------------------------------
MEASURE 27 s2[0]
MEASURE 38 s3[0]

# ------------------------------------------------------------------------------
# 3. Dynamic Hardware Classical Branching: Active Phase Frame Correction
# If s2[0] == 1 (|Phi-> state), apply physical Z pulse to Target 1 (Q26)
# If s2[0] == 0 (|Phi+> state), skip pulse to avoid excess gate noise
# ------------------------------------------------------------------------------
JUMP-UNLESS @NO_Z_CORRECTION s2[0]
Z 26
LABEL @NO_Z_CORRECTION

# ------------------------------------------------------------------------------
# 4. Readout of Corrected Diagonal Bell State (Q26, Q39)
# ------------------------------------------------------------------------------
MEASURE 26 ro[0]
MEASURE 39 ro[1]
