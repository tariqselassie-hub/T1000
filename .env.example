# T-1000 Sovereign Quantum Environment Configuration Template
# Copy this file to .env and configure your authorized credentials.
# Do NOT commit your actual .env file to version control.

# Quandela Cloud Photonic QPU Access
QUANDELA_API_KEY=your_quandela_api_key_here
QUANDELA_DEFAULT_TARGET=sim:clifford

# OpenQuantum / Rigetti Cepheus Cloud QPU Access
OPENQUANTUM_CLIENT_ID=your_openquantum_client_id_here
OPENQUANTUM_CLIENT_SECRET=your_openquantum_client_secret_here
OPEN_QUANTUM_API_KEY=your_open_quantum_api_key_here
